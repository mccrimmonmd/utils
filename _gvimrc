augroup malGvimrc
  autocmd!
  autocmd BufLeave,FocusLost * silent! wall
  autocmd VimEnter *.vim :so <afile>
  autocmd VimLeavePre * let s:save_session=input("Save session? E/M/C/D/?/<f> ")
  autocmd VimLeave * call SaveSession(s:save_session)
augroup END

