[user]
  email = saturnhs@gmail.com
  name = Malcolm Maes-McCrimmon
[pull]
  ff = only
[core]
  autocrlf = true
  editor = vim
[alias]
  ap = add --patch
  sub = restore --staged
  br = branch
  ba = branch --all
  ci = commit
  ca = commit --all
  cim = commit -m
  cam = commit --all -m
  cg = config --global
  ch = checkout
  delete-local = branch -d
  delete-remote = push -d origin
  fa = fetch --all
  fe = fetch --all --prune --prune-tags
  pr = fetch --prune --prune-tags
  low = log -5
  logf = log --name-status
  loo = log --oneline
  lo = log --oneline -16
  lof = log --oneline --name-status
  gloo = log --oneline --graph
  glo = log --oneline --graph -20
  lop = log --patch
  op = log --patch -1
  gol = log --reverse
  ool = log --oneline --reverse
  pol = log --patch --reverse
  mergem = merge main
  rebasem = rebase main --rebase-merges
  migrate = remote set-url origin
  sb = switch -
  sd = switch dev
  si = switch
  sm = switch main
  nb = switch -c
  dif = diff -- . ':(exclude)package-lock.json'
  sdif = diff --staged -- . ':(exclude)package-lock.json'
  sdiff = diff --staged
  st = status
  stashl = stash list
  stashs = stash show
  stashd = stash show --patch
  stashst = stash --staged
  unst = stash pop
  unstash = stash pop
  su = push --set-upstream origin HEAD
  taag = tag -a -m ''
  pusht = push --follow-tags
  undo = revert HEAD
  undo-soft = revert --no-commit HEAD
  undo-range = revert --no-commit
  undo-hard = reset HEAD~

